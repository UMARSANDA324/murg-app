# ============================================================
# MURG Textile Enterprises — Environment Variable Reference
# ============================================================
# Copy this file to backend/.env, then fill in values.
# NEVER commit .env files containing real credentials.
# ============================================================

# --- Node.js Environment ---
NODE_ENV=development          # 'development' | 'production'

# --- API Server ---
PORT=5000                     # Express API listens on this port

# --- Optional legacy migration source (not used by MongoDB auth) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=murg
DB_USER=root
DB_PASS=
MYSQL_MIGRATION_MODE=false

# --- Runtime database (MongoDB Atlas) ---
# Set this in local backend/.env and Render backend environment variables.
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?options
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# --- Authentication ---
# CHANGE THIS in production — use a long, random secret (32+ chars)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- EmailJS (backend OTP delivery) ---
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- CORS ---
# Frontend origin; set to the deployed frontend origin in production.
CORS_ORIGIN=http://localhost:5173
